# Copy to .env and adjust as needed. All values shown are the built-in defaults
# (see app/config.py) — you only need a .env file to override one of them.

# SQLite by default for local dev; PostgreSQL is what production should use, and
# is verified to work — schema creation and a full scan cycle were run against a
# real local PostgreSQL 16 instance during development, not just claimed:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pramaan
DATABASE_URL=sqlite:///./pramaan.db

# Where uploaded label photos are stored (served back only through the
# authenticated GET /api/scans/{id}/image endpoint — there is no public static
# file mount, precisely to avoid an IDOR/insecure-object-access hole).
UPLOAD_DIR=./uploads

# Reject uploads above this size. Enforced by a hard cap on the raw byte stream
# itself (see app/routes/scan.py), not by Content-Length alone.
MAX_UPLOAD_MB=10.0

# Tesseract language codes, "+"-joined, e.g. "eng+hin" for English + Hindi.
# Run `tesseract --list-langs` to see what's installed. Hindi keyword extraction
# (see app/pipeline/extraction.py) only works when "hin" is included here.
TESSERACT_LANGS=eng

# Field-level OCR confidence (0-100) below which a field is routed to human review
# instead of being scored automatically.
CONFIDENCE_THRESHOLD=60.0

# --- Authentication -----------------------------------------------------------

# HMAC signing key for JWTs. REQUIRED in any real deployment — if unset, a random
# key is generated per process (see app/config.py), meaning every issued token
# stops validating on the next restart and a multi-worker deployment will
# disagree with itself. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Minutes before an issued access token expires.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated "username:password:role" triples, seeded idempotently at
# startup if the accounts don't already exist. LOCAL/DEMO CONVENIENCE ONLY —
# set to an empty string to seed nothing, and never reuse these passwords
# anywhere real. Roles: citizen | inspector | department_admin.
DEMO_USERS=citizen_demo:citizen123:citizen,inspector_demo:inspector123:inspector,admin_demo:admin123:department_admin

# --- CORS -----------------------------------------------------------------------

# Comma-separated allowed origins. Defaults to local-only — never "*" here, since
# authenticated requests carry a bearer token a permissive policy would expose
# to any origin. Example for a separately-hosted frontend:
# CORS_ALLOW_ORIGINS=https://pramaan.example.gov.in
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
