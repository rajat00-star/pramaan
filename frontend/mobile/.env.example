# Copy this file to .env and set the URL for your target — never hardcode
# "localhost" in source, since on a physical device that means the phone
# itself, not your development machine. See ../../docs/mobile.md for the
# full explanation and how to find your Mac's LAN IP.

# iOS Simulator (the simulator shares your Mac's network stack):
EXPO_PUBLIC_API_URL=http://localhost:8000

# Android Emulator (10.0.2.2 is the emulator's alias for the host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Physical iPhone or Android device on the same Wi-Fi as your Mac
# (replace with your actual Mac LAN IP, e.g. via `ipconfig getifaddr en0`):
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
